# ---------------------------------------------------------------- required
# Get one at https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------ your course
SUBJECT=Sciences de la Vie et de la Terre (SVT)
TEACHER_NAME=Mr Omari
BOT_NAME=Lesson Assistant

# Reply language: ar | fr | en | auto
# "auto" replies in whatever language the student writes in.
DEFAULT_LANG=auto

# ------------------------------------------------------- protect your bill
# A shared code students enter once. WITHOUT THIS, ANYONE WITH THE LINK CAN
# USE YOUR API CREDITS. Set it before you share the link.
CLASS_CODE=svt2026

# Max questions per student per hour.
RATE_LIMIT_PER_HOUR=40

# Password for the /teacher dashboard.
TEACHER_PASSWORD=change-me

# ------------------------------------------------------------------ model
# claude-opus-5     strongest reasoning. Worth it for maths and physics.
# claude-sonnet-5   cheaper, still very capable. A good middle for SVT.
# claude-haiku-4-5  cheapest and fastest. Often enough for SVT, which is
#                   mostly definitions, mechanisms and reading diagrams.
CLAUDE_MODEL=claude-opus-5

# Reasoning depth: low | medium | high | xhigh | max
# "medium" suits most tutoring. For SVT, "low" is usually enough and cheaper.
CLAUDE_EFFORT=medium

# Set false to let the bot give full solutions to exercises.
# When true (default), it coaches with hints instead of doing homework.
HINT_MODE=true

# ------------------------------------------------------------- telegram bot
# From @BotFather on Telegram. Leave empty if you only want the web app.
TELEGRAM_BOT_TOKEN=

# --------------------------------------------------------------- advanced
PORT=3000
TOP_K=8
FULL_CONTEXT_LIMIT=60000
